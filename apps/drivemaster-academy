            flex-wrap: wrap;
            gap: 12px;
        }

        .btn {
            display: inline-block;
            padding: 14px 23px;
            border-radius: 10px;
            text-decoration: none;
            font-weight: 800;
            cursor: pointer;
        }

        .btn-primary {
            background: #22c55e;
            color: #052e16;
        }

        .btn-primary:hover {
            background: #16a34a;
            color: white;
        }

        .btn-white {
            background: white;
            color: #0f172a;
        }

        .btn-white:hover {
            background: #e2e8f0;
        }

        .btn-outline {
            border: 2px solid white;
            color: white;
        }

        .btn-outline:hover {
            background: white;
            color: #0f172a;
        }

