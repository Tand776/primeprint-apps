            margin: 40px auto 0;

            padding-top: 20px;

            border-top: 1px solid #334155;

            text-align: center;

            font-size: 14px;
        }

        /* MOBILE */

        @media (max-width: 900px) {

            .hero-content,
            .about-grid {
                grid-template-columns: 1fr;
            }

            .features {
                grid-template-columns: repeat(2,1fr);
            }

            .lesson-grid {
                grid-template-columns: 1fr;
            }

            .sign-grid {
                grid-template-columns: repeat(2,1fr);
            }

            .screenshots {
                grid-template-columns: 1fr;
            }

            .footer-content {
                grid-template-columns: 1fr;
            }

            .hero h1 {
                font-size: 45px;
            }
        }

        @media (max-width: 600px) {

            .navbar {
                flex-direction: column;
                gap: 15px;
            }

            nav a {
                margin: 0 6px;
                font-size: 13px;
            }

            .hero {
                padding: 65px 20px;
            }

            .hero h1 {
                font-size: 37px;
            }

            .features {
                grid-template-columns: 1fr;
            }

            .sign-grid {
                grid-template-columns: 1fr;
            }

            .stats {
                grid-template-columns: 1fr;
            }

            .app-logo {
                width: 120px;
                height: 120px;
                font-size: 65px;
            }

            .section-title h2 {
                font-size: 30px;
            }
        }
