            grid-template-columns: repeat(2,1fr);
            gap: 15px;
            margin-top: 20px;
        }

        .stat {
            background: rgba(255,255,255,.1);
            padding: 18px;
            border-radius: 12px;
        }

        .stat strong {
            display: block;
            font-size: 19px;
        }

        .stat span {
            color: #d1fae5;
            font-size: 13px;
        }

