            grid-template-columns: repeat(2,1fr);
            gap: 20px;
        }

        .lesson {
            display: flex;
            gap: 18px;

            padding: 25px;

            border-radius: 16px;

            background: #f8fafc;

            border-left: 5px solid #0f766e;
        }

