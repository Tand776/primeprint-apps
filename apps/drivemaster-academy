        .footer-content {
            max-width: 1200px;
            margin: auto;

            display: grid;
            grid-template-columns: 2fr 1fr 1fr;
            gap: 40px;
        }

        footer h3 {
            color: white;
            margin-bottom: 15px;
        }

        footer a {
            display: block;
            color: #cbd5e1;
            text-decoration: none;
            margin-bottom: 8px;
        }

        footer a:hover {
            color: #22c55e;
        }

        .copyright {
